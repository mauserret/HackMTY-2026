{
  "expo": {
    "name": "Banorte App",
    "slug": "banorte-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/logo_app.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./src/assets/logo_app.png",
      "resizeMode": "contain",
      "backgroundColor": "#EB0029"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/logo_app.png",
        "backgroundColor": "#EB0029"
      },
      "usesCleartextTraffic": true
    },
    "plugins": [
      "expo-audio",
      [
        "expo-font",
        {
          "fonts": [
            "./src/assets/fonts/Gotham-Bold.otf",
            "./src/assets/fonts/Gotham-Black.otf"
          ]
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Banorte necesita el micrófono para dictar tus solicitudes.",
          "speechRecognitionPermission": "Banorte necesita reconocimiento de voz para convertir tu dictado en texto.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox",
            "com.google.android.tts",
            "com.google.android.as"
          ]
        }
      ]
    ]
  }
}
