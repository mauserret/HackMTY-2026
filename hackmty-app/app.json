{
  "expo": {
    "name": "Banorte Inteligente",
    "slug": "banorte-inteligente",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "banorte-inteligente",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "mx.banorte.hackmty.inteligente"
    },
    "android": {
      "package": "mx.banorte.hackmty.inteligente",
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "pan"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Permite que Banorte escuche tu solicitud para convertirla en texto.",
          "speechRecognitionPermission": "Permite que Banorte convierta tu voz en texto.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox",
            "com.google.android.as",
            "com.google.android.tts"
          ]
        }
      ],
      "expo-font",
      "expo-asset"
    ]
  }
}
