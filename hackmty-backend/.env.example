# HTTP + WebSocket
PORT=4000
HOST=0.0.0.0
# Lista separada por comas. Vacío permite clientes nativos y cualquier origin durante la demo.
WS_ALLOWED_ORIGINS=
WS_HEARTBEAT_MS=30000
MAX_WS_PAYLOAD_BYTES=6291456
MAX_AUDIO_BYTES=4194304

# Autenticación demo
DEMO_PASSWORD=1234

# MongoDB Atlas (opcional). Sin URI, el subproceso MCP usa memoria efímera.
MONGODB_URI=
MONGODB_DB_NAME=hackmty_db
MONGODB_SERVER_SELECTION_TIMEOUT_MS=10000

# Gemini (opcional para texto; requerido para audio)
GEMINI_API_KEY=
# LLM_API_KEY funciona como alias compatible de GEMINI_API_KEY.
LLM_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TRANSCRIPTION_MODEL=gemini-3.6-flash

# MCP
MCP_REQUEST_TIMEOUT_MS=15000
