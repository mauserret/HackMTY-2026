# HTTP + WebSocket
PORT=4000
HOST=0.0.0.0
# Lista separada por comas. Vacío permite clientes nativos y cualquier origin durante la demo.
WS_ALLOWED_ORIGINS=
WS_HEARTBEAT_MS=30000
MAX_WS_PAYLOAD_BYTES=262144

# Autenticación demo
DEMO_PASSWORD=1234

# Administración (credenciales requeridas para la demo)
ADMIN_SEED_USERNAME=admin
ADMIN_SEED_PASSWORD=1
# Usa un valor largo y aleatorio para conservar sesiones entre reinicios.
ADMIN_SESSION_SECRET=
ADMIN_SESSION_TTL_MINUTES=480
ADMIN_COOKIE_SECURE=false
# Orígenes web adicionales, separados por comas.
ADMIN_ALLOWED_ORIGINS=

# MongoDB Atlas (opcional). Sin URI, el subproceso MCP usa memoria efímera.
MONGODB_URI=
MONGODB_DB_NAME=hackmty_db
MONGODB_SERVER_SELECTION_TIMEOUT_MS=10000
MONGODB_CONNECT_TIMEOUT_MS=10000
# true permite iniciar con memoria si Atlas no está disponible.
MONGODB_FALLBACK_TO_MEMORY=true
# true fuerza almacenamiento persistente y cancela el arranque ante cualquier fallo.
MONGODB_REQUIRED=false

# Gemini (opcional para generación de interfaces)
GEMINI_API_KEY=
# LLM_API_KEY funciona como alias compatible de GEMINI_API_KEY.
LLM_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# MCP
MCP_REQUEST_TIMEOUT_MS=15000
